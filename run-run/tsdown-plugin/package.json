{
  "name": "@rrlab/tsdown-plugin",
  "version": "1.2.2",
  "description": "run-run plugin for tsdown: the pack capability, a TypeScript build with tsdown.",
  "homepage": "https://github.com/withvariablelab/dx/tree/main/run-run/tsdown-plugin#readme",
  "bugs": {
    "url": "https://github.com/withvariablelab/dx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withvariablelab/dx.git",
    "directory": "run-run/tsdown-plugin"
  },
  "license": "MIT",
  "author": "rcrd <ricardo@variable.land>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@variablelab/clibuddy": "workspace:*",
    "magicast": "0.3.5"
  },
  "peerDependencies": {
    "@rrlab/cli": "workspace:^",
    "tsdown": ">=0.22.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rrlab/cli": "workspace:*",
    "@rrlab/tsdown-config": "workspace:^",
    "@types/semver": "^7.7.1",
    "semver": "^7.8.1",
    "tsdown": "0.22.0",
    "typescript": "6.0.3"
  }
}
