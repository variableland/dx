{
  "name": "@rrlab/oxc-plugin",
  "version": "1.2.1",
  "description": "run-run plugin for oxc: the lint (oxlint), format (oxfmt) and typecheck (oxlint type-aware) capabilities.",
  "homepage": "https://github.com/withvariablelab/dx/tree/main/run-run/oxc-plugin#readme",
  "bugs": {
    "url": "https://github.com/withvariablelab/dx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withvariablelab/dx.git",
    "directory": "run-run/oxc-plugin"
  },
  "license": "MIT",
  "author": "rcrd <ricardo@variable.land>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@variablelab/clibuddy": "workspace:*"
  },
  "peerDependencies": {
    "@rrlab/cli": "workspace:^",
    "oxfmt": ">=0.67.0",
    "oxlint": ">=1.0.0",
    "oxlint-tsgolint": ">=0.24.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rrlab/cli": "workspace:*",
    "@rrlab/tsdown-config": "workspace:^",
    "@types/semver": "^7.7.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "0.25.0",
    "semver": "^7.8.1"
  }
}
