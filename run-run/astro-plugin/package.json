{
  "name": "@rrlab/astro-plugin",
  "version": "0.1.0",
  "description": "Astro plugin for @rrlab/cli — provides the typecheck capability via astro check.",
  "homepage": "https://github.com/withvariablelab/dx/tree/main/run-run/astro-plugin#readme",
  "bugs": {
    "url": "https://github.com/withvariablelab/dx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withvariablelab/dx.git",
    "directory": "run-run/astro-plugin"
  },
  "license": "MIT",
  "author": "rcrd <ricardo@variable.land>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@variablelab/clibuddy": "workspace:*"
  },
  "peerDependencies": {
    "@astrojs/check": ">=0.9.0",
    "@rrlab/cli": "workspace:^",
    "astro": ">=5.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@rrlab/cli": "workspace:*",
    "@rrlab/tsdown-config": "workspace:^",
    "@types/semver": "^7.7.1",
    "astro": "7.4.0",
    "semver": "^7.8.1",
    "typescript": "6.0.3"
  }
}
